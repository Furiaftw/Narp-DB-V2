# Copy this file to `.env` for local development. Never commit the real `.env`.
# In production these are set in the Netlify dashboard (Site settings → Environment variables).

# --- Supabase ---
# Only one of the two URL variables is needed (VITE_SUPABASE_URL wins if both set).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Web Push notifications (VAPID) ---
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the browser and is safe to expose.
# The PRIVATE key is a SECRET — server-side only, never prefix it with VITE_.
#
# Client (build-time, exposed to the browser):
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
#
# Server (Netlify Functions only — set these in the Netlify dashboard, mark the
# private key as "secret"):
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
